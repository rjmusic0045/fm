# ---------------------------------------------------------------------------
# Lumen FM environment. Copy to .env (local) or add to Vercel project settings.
# ---------------------------------------------------------------------------

# Public base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (MongoDB) ----------------------------------------------------
# Prisma needs a replica set. MongoDB Atlas works out of the box:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lumen?retryWrites=true&w=majority
# Local (docker compose up -d):
DATABASE_URL=mongodb://localhost:27017/lumen?replicaSet=rs0&directConnection=true

# --- NextAuth ----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# --- Facebook OAuth (optional; button shows a notice when unset) ------------
# Valid OAuth Redirect URI in the Facebook app:
#   http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email (SMTP). Without it, emails are printed to the server console in dev.
# Resend:  smtp://resend:RE_xxxxxxxx@smtp.resend.com:587
# Mailtrap: smtp://USER:PASS@sandbox.smtp.mailtrap.io:2525
EMAIL_SERVER=
EMAIL_FROM="Lumen FM <no-reply@yourdomain.com>"

# --- Stripe (used from Phase 7) ----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=

# --- Seeding (optional): creates an ADMIN user when running `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Uploaded media (songs + covers) -------------------------------------------
# Azure Blob Storage (recommended in production). Portal: Storage account ->
# Security + networking -> Access keys -> key1 -> Connection string.
# The container is created automatically and kept private.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
# Without a connection string, files go to local disk: UPLOAD_DIR, or ./storage/uploads.
UPLOAD_DIR=
